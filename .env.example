# Caminho local do modelo (gerado por scripts/download_model.py) ou ID no Hugging Face.
MODEL_PATH=./models/ocr-captcha-v3
# cpu, cuda, mps ou auto
DEVICE=auto
# Feixes do beam search (o modelo foi avaliado com 2)
NUM_BEAMS=2
# Limpeza da imagem antes do modelo: none, median (tira o ruído de pontos) ou median_bin.
# Escolha com scripts/evaluate.py.
PREPROCESS=none
# Tamanho máximo da imagem recebida, em bytes
MAX_IMAGE_BYTES=2000000
# Se definido, toda chamada precisa do header X-API-Key com este valor
API_KEY=
